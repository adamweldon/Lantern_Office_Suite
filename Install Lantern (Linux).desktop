[Desktop Entry]
Type=Application
Version=1.0
Name=Install Lantern
Comment=Set up Lantern's offline AI on this computer (needs internet once). If asked, choose Execute.
Exec=sh -c "t=\\"\\$*\\"; [ -n \\"\\$t\\" ] || t=\\"\\$GIO_LAUNCHED_DESKTOP_FILE\\"; [ -d \\"\\$t\\" ] || t=\\$(dirname \\"\\$t\\"); exec sh \\"\\$t/kit/lantern-kit.sh\\" install" lantern %k
Icon=system-software-install
Terminal=false
Categories=Education;
