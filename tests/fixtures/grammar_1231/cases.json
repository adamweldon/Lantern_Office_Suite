[
 {
  "name": "STATION",
  "grammar": "root ::= \"MAKE STATION: \" title \"\\n\" (line \"\\n\")* \"END\"\ntitle ::= [^\\n]+\nline ::= (\"pumps\" | \"Pumps\" | \"pump\" | \"Pump\" | \"floats\" | \"Floats\" | \"float\" | \"Float\" | \"well\" | \"Well\" | \"inlet\" | \"Inlet\" | \"main\" | \"Main\" | \"header\" | \"Header\" | \"valves\" | \"Valves\" | \"valve\" | \"Valve\" | \"supply\" | \"Supply\" | \"show\" | \"Show\" | \"note\" | \"Note\" | \"vent\" | \"Vent\" | \"horn\" | \"Horn\" | \"lights\" | \"Lights\" | \"simplex\" | \"Simplex\" | \"duplex\" | \"Duplex\" | \"triplex\" | \"Triplex\") ([ \\t:=] [^\\n]*)?",
  "samples": [
   {
    "text": "MAKE STATION: Lift station\npumps 2\nfloats off lead lag alarm\nEND",
    "want": true
   },
   {
    "text": "MAKE STATION: Sewage station\npumps 2\nfloats off lead lag alarm\nfloat FS1 \"off\" 1 m\nfloat FS2 \"lead on\" 1.5 m\nwell \"wet well\" 3 m\ninlet \"200 mm gravity sewer\" 2.4 m\nmain \"100 mm force main\"\nvalves plug\nsupply \"120 V AC\"\nEND",
    "want": true
   },
   {
    "text": "MAKE STATION: Sump\nPumps: 1\nEND",
    "want": true
   },
   {
    "text": "MAKE STATION: Lift station — duplex\npumps 2\nEND",
    "want": true
   },
   {
    "text": "Here is the block:\nMAKE STATION: Lift station\npumps 2\nEND",
    "want": false
   },
   {
    "text": "MAKE STATION: Lift station\nThe station has two pumps that take turns.\nEND",
    "want": false
   },
   {
    "text": "MAKE STATION: Lift station\npumps 2\nfloats off lead lag alarm",
    "want": false
   },
   {
    "text": "MAKE CONTROL: Lift station\npumps 2\nEND",
    "want": false
   },
   {
    "text": "MAKE STATION: Lift station\npumps 2\nEND\nThat is the station.",
    "want": false
   }
  ]
 },
 {
  "name": "CONTROL",
  "grammar": "root ::= \"MAKE CONTROL: \" title \"\\n\" (line \"\\n\")* \"END\"\ntitle ::= [^\\n]+\nline ::= (\"stop\" | \"Stop\" | \"start\" | \"Start\" | \"button\" | \"Button\" | \"pushbutton\" | \"Pushbutton\" | \"pb\" | \"Pb\" | \"estop\" | \"Estop\" | \"switch\" | \"Switch\" | \"selector\" | \"Selector\" | \"toggle\" | \"Toggle\" | \"ss\" | \"Ss\" | \"limit\" | \"Limit\" | \"ls\" | \"Ls\" | \"pressure\" | \"Pressure\" | \"ps\" | \"Ps\" | \"float\" | \"Float\" | \"level\" | \"Level\" | \"fs\" | \"Fs\" | \"temperature\" | \"Temperature\" | \"temp\" | \"Temp\" | \"thermostat\" | \"Thermostat\" | \"ts\" | \"Ts\" | \"overload\" | \"Overload\" | \"overloads\" | \"Overloads\" | \"ol\" | \"Ol\" | \"coil\" | \"Coil\" | \"contactor\" | \"Contactor\" | \"starter\" | \"Starter\" | \"relay\" | \"Relay\" | \"cr\" | \"Cr\" | \"k\" | \"K\" | \"timer\" | \"Timer\" | \"tr\" | \"Tr\" | \"ton\" | \"Ton\" | \"delay\" | \"Delay\" | \"lamp\" | \"Lamp\" | \"light\" | \"Light\" | \"pilot\" | \"Pilot\" | \"indicator\" | \"Indicator\" | \"bulb\" | \"Bulb\" | \"lt\" | \"Lt\" | \"pl\" | \"Pl\" | \"solenoid\" | \"Solenoid\" | \"sol\" | \"Sol\" | \"horn\" | \"Horn\" | \"buzzer\" | \"Buzzer\" | \"alarm\" | \"Alarm\" | \"bell\" | \"Bell\" | \"siren\" | \"Siren\" | \"fuse\" | \"Fuse\" | \"fu\" | \"Fu\" | \"interlock\" | \"Interlock\" | \"supply\" | \"Supply\" | \"transformer\" | \"Transformer\" | \"power\" | \"Power\" | \"alternator\" | \"Alternator\" | \"alternating\" | \"Alternating\" | \"alternate\" | \"Alternate\" | \"alternation\" | \"Alternation\" | \"duplexer\" | \"Duplexer\" | \"note\" | \"Note\" | \"text\" | \"Text\" | \"label\" | \"Label\" | \"mode\" | \"Mode\" | \"part\" | \"Part\" | \"motor\" | \"Motor\" | \"magnetic\" | \"Magnetic\" | \"push\" | \"Push\" | \"emergency\" | \"Emergency\" | \"control\" | \"Control\") ([ \\t:=] [^\\n]*)?",
  "samples": [
   {
    "text": "MAKE CONTROL: Duplex pump station\nsupply \"120 V AC\"\nfloat FS1 \"off\"\nfloat FS2 \"lead on\"\nfloat FS3 \"lag on\"\nfloat FS4 \"high level alarm\"\nalternator AR M1 M2\ncoil M1 \"pump 1 starter\"\ncoil M2 \"pump 2 starter\"\nlamp LT1 M1 \"pump 1 run\" green\nEND",
    "want": true
   },
   {
    "text": "MAKE CONTROL: Motor starter\nstop PB1\nstart PB2 M1\noverload OL1 M1\ncoil M1 \"motor starter\"\nlamp LT1 M1 \"run\" green\nEND",
    "want": true
   },
   {
    "text": "MAKE CONTROL: Duplex\nThe floats start the pumps.\nEND",
    "want": false
   },
   {
    "text": "MAKE CONTROL: Duplex\nfloat FS1 \"off\"\nWire L1 to FS1 then to CR1.\nEND",
    "want": false
   }
  ]
 },
 {
  "name": "PIPING",
  "grammar": "root ::= \"MAKE PIPING: \" title \"\\n\" (line \"\\n\")* \"END\"\ntitle ::= [^\\n]+\nline ::= (\"well\" | \"Well\" | \"wetwell\" | \"Wetwell\" | \"sump\" | \"Sump\" | \"pit\" | \"Pit\" | \"basin\" | \"Basin\" | \"tank\" | \"Tank\" | \"inlet\" | \"Inlet\" | \"influent\" | \"Influent\" | \"inflow\" | \"Inflow\" | \"sewer\" | \"Sewer\" | \"gravity\" | \"Gravity\" | \"incoming\" | \"Incoming\" | \"pump\" | \"Pump\" | \"pumps\" | \"Pumps\" | \"submersible\" | \"Submersible\" | \"check\" | \"Check\" | \"cv\" | \"Cv\" | \"nrv\" | \"Nrv\" | \"non-return\" | \"Non-return\" | \"nonreturn\" | \"Nonreturn\" | \"valve\" | \"Valve\" | \"gate\" | \"Gate\" | \"plug\" | \"Plug\" | \"ball\" | \"Ball\" | \"butterfly\" | \"Butterfly\" | \"isolation\" | \"Isolation\" | \"isolating\" | \"Isolating\" | \"shutoff\" | \"Shutoff\" | \"shut-off\" | \"Shut-off\" | \"gv\" | \"Gv\" | \"pv\" | \"Pv\" | \"bv\" | \"Bv\" | \"header\" | \"Header\" | \"manifold\" | \"Manifold\" | \"main\" | \"Main\" | \"forcemain\" | \"Forcemain\" | \"rising\" | \"Rising\" | \"outlet\" | \"Outlet\" | \"discharge\" | \"Discharge\" | \"vent\" | \"Vent\" | \"vault\" | \"Vault\" | \"valvebox\" | \"Valvebox\" | \"note\" | \"Note\" | \"text\" | \"Text\" | \"label\" | \"Label\" | \"wet\" | \"Wet\" | \"force\" | \"Force\" | \"swing\" | \"Swing\" | \"air\" | \"Air\") ([ \\t:=] [^\\n]*)?",
  "samples": [
   {
    "text": "MAKE PIPING: Lift station\nwell \"wet well\"\ninlet \"8 in gravity sewer\"\npump P1 \"pump 1\"\npump P2 \"pump 2\"\ncheck CV1 P1\nvalve V1 P1 plug\nheader \"4 in force main\"\nvent\nEND",
    "want": true
   },
   {
    "text": "MAKE PIPING: Station\nwet well \"wet well\"\nforce main \"4 in\"\npump P1\nEND",
    "want": true
   },
   {
    "text": "MAKE PIPING: Station\nThe pumps discharge into a header.\nEND",
    "want": false
   }
  ]
 },
 {
  "name": "LEVELS",
  "grammar": "root ::= \"MAKE LEVELS: \" title \"\\n\" (line \"\\n\")* \"END\"\ntitle ::= [^\\n]+\nline ::= (\"well\" | \"Well\" | \"wetwell\" | \"Wetwell\" | \"sump\" | \"Sump\" | \"pit\" | \"Pit\" | \"basin\" | \"Basin\" | \"tank\" | \"Tank\" | \"pump\" | \"Pump\" | \"pumps\" | \"Pumps\" | \"submersible\" | \"Submersible\" | \"float\" | \"Float\" | \"floats\" | \"Floats\" | \"level\" | \"Level\" | \"switch\" | \"Switch\" | \"inlet\" | \"Inlet\" | \"influent\" | \"Influent\" | \"inflow\" | \"Inflow\" | \"sewer\" | \"Sewer\" | \"invert\" | \"Invert\" | \"note\" | \"Note\" | \"text\" | \"Text\" | \"label\" | \"Label\" | \"off\" | \"Off\" | \"stop\" | \"Stop\" | \"lead\" | \"Lead\" | \"lag\" | \"Lag\" | \"alarm\" | \"Alarm\" | \"start\" | \"Start\" | \"floor\" | \"Floor\" | \"bottom\" | \"Bottom\" | \"base\" | \"Base\" | \"wet\" | \"Wet\") ([ \\t:=] [^\\n]*)?",
  "samples": [
   {
    "text": "MAKE LEVELS: Wet well\nwell \"wet well\" 10 ft\npump P1 P2\nfloat FS1 \"off\" 2 ft\nfloat FS2 \"lead on\" 3.5 ft\ninlet \"inlet invert\" 6.5 ft\nEND",
    "want": true
   },
   {
    "text": "MAKE LEVELS: Wet well\nThe off float is at the bottom.\nEND",
    "want": false
   }
  ]
 },
 {
  "name": "SHEET",
  "grammar": "root ::= \"MAKE SHEET: \" title \"\\n\" (line \"\\n\")* \"END\"\ntitle ::= [^\\n]+\nline ::= [^\\n]*",
  "samples": [
   {
    "text": "MAKE SHEET: Shopping\nItem | Qty | Price | Cost\nBread | 2 | 1.50 | =B2*C2\nEND",
    "want": true
   },
   {
    "text": "Sure! MAKE SHEET: Shopping\nItem | Qty\nEND",
    "want": false
   },
   {
    "text": "MAKE SHEET: Shopping\nItem | Qty\n",
    "want": false
   }
  ]
 },
 {
  "name": "SCHEMATIC",
  "grammar": "root ::= \"MAKE SCHEMATIC: \" title \"\\n\" (line \"\\n\")* \"END\"\ntitle ::= [^\\n]+\nline ::= [^\\n]*",
  "samples": [
   {
    "text": "MAKE SCHEMATIC: Lamp circuit\npart B1 battery \"12 V\"\npart L1 lamp\nwire B1+ L1\nEND",
    "want": true
   },
   {
    "text": "MAKE SCHEMATIC: Lamp\n\nEND",
    "want": true
   },
   {
    "text": "MAKE SCHEMATIC: Lamp circuit\npart B1 battery\nEND\nI hope this helps.",
    "want": false
   }
  ]
 },
 {
  "name": "CODE",
  "grammar": "root ::= \"MAKE CODE: \" title \"\\n\" (line \"\\n\")* \"END\"\ntitle ::= [^\\n]+\nline ::= [^\\n]*",
  "samples": [
   {
    "text": "MAKE CODE: Blink\nlanguage arduino\nvoid setup() { pinMode(13, OUTPUT); }\nvoid loop() { digitalWrite(13, HIGH); delay(500); digitalWrite(13, LOW); delay(500); }\nEND",
    "want": true
   }
  ]
 },
 {
  "name": "DOC",
  "grammar": "root ::= \"MAKE DOC: \" title \"\\n\" (line \"\\n\")* \"END\"\ntitle ::= [^\\n]+\nline ::= [^\\n]*",
  "samples": [
   {
    "text": "MAKE DOC: Notes\n# Notes\nA paragraph with \"quotes\" and a back\\slash.\nEND",
    "want": true
   }
  ]
 }
]
