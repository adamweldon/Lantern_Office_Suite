[Desktop Entry]
Type=Application
Version=1.0
Name=Start Lantern
Comment=Start Lantern's offline AI and open Lantern. If asked, choose Execute.
Exec=sh -c "t=\\"\\$*\\"; [ -n \\"\\$t\\" ] || t=\\"\\$GIO_LAUNCHED_DESKTOP_FILE\\"; [ -d \\"\\$t\\" ] || t=\\$(dirname \\"\\$t\\"); exec sh \\"\\$t/kit/lantern-kit.sh\\" start" lantern %k
Icon=media-playback-start
Terminal=false
Categories=Education;
